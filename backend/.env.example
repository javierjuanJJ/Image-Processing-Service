DATABASE_URL="postgresql://postgres:postgres@localhost:5432/image_processing?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1h"
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
QUEUE_ENABLED=false
RABBIT_URL=amqp://localhost

# ---------------------------------------------------------------------------
# Storage configuration
# ---------------------------------------------------------------------------
# Options: disk | s3 | r2 | gcs
STORAGE_PROVIDER=disk

# ---------------------------------------------------------------------------
# Local disk storage (used when STORAGE_PROVIDER=disk)
# ---------------------------------------------------------------------------
UPLOADS_DIR=uploads

# ---------------------------------------------------------------------------
# AWS S3 / Cloudflare R2 (used when STORAGE_PROVIDER=s3 or STORAGE_PROVIDER=r2)
# ---------------------------------------------------------------------------
STORAGE_BUCKET=my-image-bucket
STORAGE_REGION=us-east-1
# For Cloudflare R2, set STORAGE_ENDPOINT to your account-specific endpoint:
#   https://<accountid>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Google Cloud Storage (used when STORAGE_PROVIDER=gcs)
# ---------------------------------------------------------------------------
# STORAGE_BUCKET is also used for GCS bucket name
# Point STORAGE_KEY_FILENAME to your service account key JSON file:
STORAGE_KEY_FILENAME=
