{
  "name": "image-processing-service-backend",
  "version": "0.1.0",
  "description": "API de gestión y procesamiento de imágenes tipo Cloudinary (self-hosted)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "app.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch app.js",
    "start": "node --env-file-if-exists=.env app.js",
    "worker": "node --env-file-if-exists=.env workers/transform.worker.js",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@prisma/client": "^6.19.0",
    "amqplib": "^0.10.8",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "sharp": "^0.34.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
