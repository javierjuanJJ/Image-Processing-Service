generator client {
  provider      = "prisma-client-js"
  // El runtime (node:22-bookworm-slim) usa OpenSSL 3.0. Fijamos el target
  // explícitamente para que `prisma generate` descargue el query engine
  // compatible también cuando se construye la imagen en otro host.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  images    Image[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Image {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  storagePath String
  variants    Json?
  transforms  TransformLog[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("images")
}

model TransformLog {
  id        String   @id @default(cuid())
  imageId   String
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  operation Json
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([imageId])
  @@map("transform_logs")
}
