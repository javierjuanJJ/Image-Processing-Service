# Plantilla para docker compose. Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env

# --- API -------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
API_PORT=3000

# --- Cola de transformaciones ----------------------------------------------
# true  -> POST /images/:id/transform responde 202 y el worker procesa la cola
# false -> transformación síncrona (no requiere el worker ni RabbitMQ)
QUEUE_ENABLED=true

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_processing
POSTGRES_PORT=5432
# Debe coincidir con POSTGRES_USER/PASSWORD/DB y apuntar al host "postgres".
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/image_processing?schema=public

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBIT_URL=amqp://guest:guest@rabbitmq:5672

# --- Storage ---------------------------------------------------------------
# Por defecto se usa S3 emulado por Floci (servicio "floci").
# Pon STORAGE_PROVIDER=disk para volver al disco local (STORAGE_ENDPOINT se ignora).
# disk | s3 | r2 | gcs
STORAGE_PROVIDER=s3
STORAGE_BUCKET=image-processing
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://floci:4566
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test
STORAGE_KEY_FILENAME=

# --- Floci (emulador local de AWS / S3) ------------------------------------
FLOCI_PORT=4566
# persistent | ephemeral
FLOCI_STORAGE_MODE=persistent

